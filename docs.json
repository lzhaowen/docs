{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Neural4D API Docs",
  "description": "Neural4D API documentation in English and Chinese.",
  "colors": {
    "primary": "#661FFE",
    "light": "#661FFE",
    "dark": "#661FFE"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "versions": [
          {
            "version": "old",
            "default": true,
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "en/index",
                  "en/quickstart"
                ]
              },
              {
                "group": "API reference",
                "openapi": {
                  "source": "openapi.old.json",
                  "directory": "en-api-reference"
                }
              }
            ]
          },
          {
            "version": "v1",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "en/v1-overview",
                  "en/common-headers"
                ]
              },
              {
                "group": "API reference",
                "openapi": {
                  "source": "openapi.json",
                  "directory": "en-v1-api-reference"
                }
              }
            ]
          }
        ]
      },
      {
        "language": "zh",
        "versions": [
          {
            "version": "old",
            "default": true,
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/index",
                  "zh/quickstart"
                ]
              },
              {
                "group": "API 参考",
                "openapi": {
                  "source": "openapi.old.zh.json",
                  "directory": "zh-api-reference"
                }
              }
            ]
          },
          {
            "version": "v1",
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/v1-overview",
                  "zh/common-headers"
                ]
              },
              {
                "group": "API 参考",
                "openapi": {
                  "source": "openapi.zh.json",
                  "directory": "zh-v1-api-reference"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/n4d-black.png",
    "dark": "/logo/n4d-white.png"
  },
  "api": {
    "playground": {
      "display": "simple",
      "proxy": true,
      "credentials": false
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "node",
        "typescript",
        "go",
        "java",
        "csharp",
        "php"
      ],
      "defaults": "all",
      "prefill": true,
      "autogenerate": true
    }
  },
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  }
}
