{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Neural4D API Docs",
  "description": "Neural4D API documentation in English and Chinese.",
  "colors": {
    "primary": "#661FFE",
    "light": "#661FFE",
    "dark": "#661FFE"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "versions": [
          {
            "version": "v1",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "en/v1-overview",
                  "en/common-headers"
                ]
              },
              {
                "group": "API reference",
                "pages": [
                  {
                    "group": "Files",
                    "pages": ["en/v1-api-reference/files/upload-a-file"]
                  },
                  {
                    "group": "Video generation",
                    "pages": ["en/v1-api-reference/video-generation/create-video-generation-tasks"]
                  },
                  {
                    "group": "Tasks",
                    "pages": ["en/v1-api-reference/tasks/retrieve-a-task"]
                  }
                ]
              }
            ]
          },
          {
            "version": "old",
            "default": true,
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "en/quickstart",
                  "en/old-overview"
                ]
              },
              {
                "group": "API reference",
                "pages": [
                  {
                    "group": "Text to 3D",
                    "pages": ["en/api-reference/text-to-3d/generate-model-from-text"]
                  },
                  {
                    "group": "Model management",
                    "pages": [
                      "en/api-reference/model-management/retrieve-model",
                      "en/api-reference/model-management/convert-model-format",
                      "en/api-reference/model-management/query-job-progress"
                    ]
                  },
                  {
                    "group": "Image to 3D",
                    "pages": [
                      "en/api-reference/image-to-3d/generate-model-with-image",
                      "en/api-reference/image-to-3d/generate-chibi-style-model-with-image"
                    ]
                  },
                  {
                    "group": "Picture and video generation",
                    "pages": [
                      "en/api-reference/media-generation/generate-picture",
                      "en/api-reference/media-generation/generate-video",
                      "en/api-reference/media-generation/retrieve-generation-result"
                    ]
                  },
                  {
                    "group": "Account and validation",
                    "pages": [
                      "en/api-reference/account-and-validation/detect-portrait-image",
                      "en/api-reference/account-and-validation/query-remaining-balance"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "zh",
        "versions": [
          {
            "version": "v1",
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/v1-overview",
                  "zh/common-headers"
                ]
              },
              {
                "group": "API 参考",
                "pages": [
                  {
                    "group": "文件",
                    "pages": ["zh/v1-api-reference/files/upload-a-file"]
                  },
                  {
                    "group": "视频生成",
                    "pages": ["zh/v1-api-reference/video-generation/create-video-generation-tasks"]
                  },
                  {
                    "group": "任务",
                    "pages": ["zh/v1-api-reference/tasks/retrieve-a-task"]
                  }
                ]
              }
            ]
          },
          {
            "version": "old",
            "default": true,
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "zh/quickstart",
                  "zh/old-overview"
                ]
              },
              {
                "group": "API 参考",
                "pages": [
                  {
                    "group": "文本生成 3D",
                    "pages": ["zh/api-reference/text-to-3d/generate-model-from-text"]
                  },
                  {
                    "group": "模型管理",
                    "pages": [
                      "zh/api-reference/model-management/retrieve-model",
                      "zh/api-reference/model-management/convert-model-format",
                      "zh/api-reference/model-management/query-job-progress"
                    ]
                  },
                  {
                    "group": "图片生成 3D",
                    "pages": [
                      "zh/api-reference/image-to-3d/generate-model-with-image",
                      "zh/api-reference/image-to-3d/generate-chibi-style-model-with-image"
                    ]
                  },
                  {
                    "group": "图片与视频生成",
                    "pages": [
                      "zh/api-reference/media-generation/generate-picture",
                      "zh/api-reference/media-generation/generate-video",
                      "zh/api-reference/media-generation/retrieve-generation-result"
                    ]
                  },
                  {
                    "group": "账户与校验",
                    "pages": [
                      "zh/api-reference/account-and-validation/detect-portrait-image",
                      "zh/api-reference/account-and-validation/query-remaining-balance"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/n4d-black.png",
    "dark": "/logo/n4d-white.png",
    "href": "/en/quickstart"
  },
  "api": {
    "playground": {
      "display": "simple",
      "proxy": true,
      "credentials": false
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "typescript",
        "java",
        "go",
        "ruby",
        "php",
        "csharp"
      ],
      "defaults": "all",
      "prefill": true,
      "autogenerate": true
    }
  },
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en/quickstart"
    },
    {
      "source": "/en",
      "destination": "/en/quickstart"
    },
    {
      "source": "/zh",
      "destination": "/zh/quickstart"
    },
    {
      "source": "/en-api-reference/:path*",
      "destination": "/en/api-reference/:path*"
    },
    {
      "source": "/zh-api-reference/:path*",
      "destination": "/zh/api-reference/:path*"
    },
    {
      "source": "/en-v1-api-reference/:path*",
      "destination": "/en/v1-api-reference/:path*"
    }
  ]
}
