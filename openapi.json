              "2:3",
              "3:2"
            ],
            "default": "16:9",
            "description": "Aspect ratio allowed by the selected video model."
          },
          "duration": {
            "type": "integer",
            "minimum": 6,
            "maximum": 30,
            "enum": [
              6,
